---
permalink: /.htaccess
eleventyExcludeFromCollections: true
templateEngineOverride: njk
---
# Apache settings (requires AllowOverride on the server)
ErrorDocument 404 /404.html

# Browser caching. Font files never change in place, and pages link the stylesheet with a
# hash of its contents (?v=...), so both keep for a year. Scripts and images aren't renamed
# when they change, so they keep for a day. Pages and text files (robots.txt, llms.txt)
# always revalidate.
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2|css)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.(js|svg|png|ico)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "\.(html|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Show ACR.md as UTF-8 text in the browser instead of downloading it or garbling "·" and "–"
<Files "{{ meta.file_name }}">
    ForceType "text/plain; charset=utf-8"
</Files>

# llms.txt (a summary for AI agents) has the same characters
<Files "llms.txt">
    ForceType "text/plain; charset=utf-8"
</Files>

# Source maps (only devtools load them) are JSON, which Apache doesn't know by default
AddType application/json .map
